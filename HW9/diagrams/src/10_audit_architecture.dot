digraph G {
  rankdir=LR;
  labelloc="t";
  label="Доработанная архитектура аудита под 10 000 RPS (с пиками)";
  fontsize=18; fontcolor="#0f172a";
  graph [fontname="DejaVu Sans", bgcolor="white", pad=0.6, nodesep=0.42, ranksep=1.05, splines=spline, compound=true];
  node [fontname="DejaVu Sans", fontsize=11, shape=box, style="rounded,filled", fillcolor="#e0f2fe", color="#0284c7", fontcolor="#0f172a", penwidth=1.6, margin="0.22,0.14"];
  edge [fontname="DejaVu Sans", fontsize=9, color="#64748b", fontcolor="#475569", arrowsize=0.7, penwidth=1.15];

  subgraph cluster_src {
    label=<<B>Источники аудита (steady / peak ×3)</B>>; fontname="DejaVu Sans"; fontsize=12; fontcolor="#475569";
    style="rounded,filled"; color="#cbd5e1"; bgcolor="#f8fafc"; penwidth=1.4; margin=14;
    s_gw [label=<<B>API Gateway</B><BR/><FONT POINT-SIZE="9" COLOR="#475569">access + data-access: 10k/с</FONT>>, fillcolor="#e0f2fe", color="#0284c7"];
    s_gr [label=<<B>Guardrails</B><BR/><FONT POINT-SIZE="9" COLOR="#475569">решения: summary 5k/с + ВСЕ BLOCK/ESCALATE</FONT>>, fillcolor="#fee2e2", color="#dc2626"];
    s_bi [label=<<B>Billing</B><BR/><FONT POINT-SIZE="9" COLOR="#475569">usage/проводки: 10k/с</FONT>>, fillcolor="#ede9fe", color="#7c3aed"];
    s_kc [label=<<B>Keycloak</B><BR/><FONT POINT-SIZE="9" COLOR="#475569">логин/refresh/роли: ~100/с (не каждая JWT)</FONT>>, fillcolor="#e0f2fe", color="#0284c7"];
    s_cf [label=<<B>Конфиг / Policy</B><BR/><FONT POINT-SIZE="9" COLOR="#475569">изменения моделей и правил: &lt; 1/с</FONT>>, fillcolor="#fef9c3", color="#ca8a04"];
  }

  subgraph cluster_buf {
    label=<<B>Буферизация (не теряем при сбоях и пиках)</B>>; fontname="DejaVu Sans"; fontsize=12; fontcolor="#0d9488";
    style="rounded,filled"; color="#5eead4"; bgcolor="#f0fdfa"; penwidth=1.4; margin=14;
    wal [label=<<B>Local WAL (агент)</B><BR/><FONT POINT-SIZE="9" COLOR="#475569">диск-буфер на каждом хосте,<BR/>переживает недоступность Kafka</FONT>>, fillcolor="#ccfbf1", color="#0d9488"];
    kfk [label=<<B>Kafka audit.events</B><BR/><FONT POINT-SIZE="9" COLOR="#475569">партиции по tenant, сжатие, retention 3–7 дней</FONT>>, fillcolor="#ccfbf1", color="#0d9488"];
  }

  subgraph cluster_proc {
    label=<<B>Обработка (out-of-band, autoscale)</B>>; fontname="DejaVu Sans"; fontsize=12; fontcolor="#4f46e5";
    style="rounded,filled"; color="#c7d2fe"; bgcolor="#eef2ff"; penwidth=1.4; margin=14;
    agg [label=<<B>Aggregator / Merger</B><BR/><FONT POINT-SIZE="9" COLOR="#475569">слияние по request_id → Case,<BR/>маскирование ПДн, хэши payload</FONT>>, fillcolor="#e0e7ff", color="#4f46e5"];
    ev  [label=<<B>Evidence Store</B><BR/><FONT POINT-SIZE="9" COLOR="#475569">payload только BLOCK/ESCALATE и 1–3% выборка</FONT>>, shape=cylinder, style=filled, fillcolor="#f1f5f9", color="#94a3b8"];
  }

  subgraph cluster_int {
    label=<<B>Целостность (Merkle + шардированная цепь)</B>>; fontname="DejaVu Sans"; fontsize=12; fontcolor="#7c3aed";
    style="rounded,filled"; color="#c4b5fd"; bgcolor="#faf5ff"; penwidth=1.4; margin=14;
    bat [label=<<B>Merkle Batcher</B><BR/><FONT POINT-SIZE="9" COLOR="#475569">микро-батч 5k событий / 1 с → корень</FONT>>, fillcolor="#ede9fe", color="#7c3aed"];
    shd [label=<<B>Hash-chain шарды</B><BR/><FONT POINT-SIZE="9" COLOR="#475569">HMAC-цепь по tenant/регионам<BR/>(нет единого serial-горлышка)</FONT>>, fillcolor="#ede9fe", color="#7c3aed"];
    sig [label=<<B>Signer / Sealer</B><BR/><FONT POINT-SIZE="9" COLOR="#475569">1 асимм. подпись на батч (не на событие)</FONT>>, fillcolor="#ede9fe", color="#7c3aed"];
  }

  subgraph cluster_store {
    label=<<B>Хранение (tiered retention)</B>>; fontname="DejaVu Sans"; fontsize=12; fontcolor="#475569";
    style="rounded,filled"; color="#cbd5e1"; bgcolor="#f8fafc"; penwidth=1.4; margin=14;
    worm [label=<<B>WORM (S3 Object Lock)</B><BR/><FONT POINT-SIZE="9" COLOR="#475569">envelopes + Merkle-proof, 1–3 года</FONT>>, shape=cylinder, style=filled, fillcolor="#e2e8f0", color="#475569"];
    idx  [label=<<B>Columnar index</B><BR/><FONT POINT-SIZE="9" COLOR="#475569">ClickHouse/OpenSearch, hot 30–90 дней</FONT>>, shape=cylinder, style=filled, fillcolor="#e2e8f0", color="#475569"];
  }

  subgraph cluster_ctrl {
    label=<<B>Потребители и контроль</B>>; fontname="DejaVu Sans"; fontsize=12; fontcolor="#0d9488";
    style="rounded,filled"; color="#5eead4"; bgcolor="#f0fdfa"; penwidth=1.4; margin=14;
    qry [label=<<B>Audit Query API</B><BR/><FONT POINT-SIZE="9" COLOR="#475569">read-only, отдельная RBAC-роль</FONT>>, fillcolor="#ccfbf1", color="#0d9488"];
    siem[label=<<B>SIEM</B><BR/><FONT POINT-SIZE="9" COLOR="#475569">только security-subset (0.5–2k/с)</FONT>>, fillcolor="#ccfbf1", color="#0d9488"];
    ver [label=<<B>Verifier</B><BR/><FONT POINT-SIZE="9" COLOR="#475569">пересчёт цепи, Merkle-proof</FONT>>, fillcolor="#ccfbf1", color="#0d9488"];
    anc [label=<<B>Внешнее анкоринг</B><BR/><FONT POINT-SIZE="9" COLOR="#475569">периодический timestamp корня</FONT>>, fillcolor="#ccfbf1", color="#0d9488"];
  }

  s_gw -> wal; s_gr -> wal; s_bi -> wal; s_kc -> wal; s_cf -> wal;
  wal -> kfk [label="at-least-once", color="#0d9488", fontcolor="#0f766e", penwidth=1.8];
  kfk -> agg [color="#4f46e5", fontcolor="#4338ca", penwidth=1.8];
  agg -> idx [label="горячий поиск", color="#4f46e5", fontcolor="#4338ca", penwidth=1.6];
  agg -> bat [color="#7c3aed", fontcolor="#6d28d9", penwidth=1.8];
  agg -> ev  [style=dashed, color="#94a3b8"];
  bat -> shd [color="#7c3aed", penwidth=1.6];
  shd -> sig [color="#7c3aed", penwidth=1.6];
  sig -> worm [label="sealed batch", color="#7c3aed", fontcolor="#6d28d9", penwidth=1.8];
  agg -> siem [label="фильтр security-subset", style=dashed, color="#0d9488", fontcolor="#0f766e"];
  idx -> qry [penwidth=1.6];
  worm -> qry [style=dashed];
  worm -> ver [style=dashed];
  ver -> anc [style=dashed];
  ev -> qry [style=dashed, color="#94a3b8"];

  note [label=<<B>Что НЕ аудируем поголовно</B><BR/><FONT POINT-SIZE="9" COLOR="#475569">per-chunk PASS стриминга, каждую валидацию JWT, кэш-попадания с payload.<BR/>Вместо этого: summary + rollup-hash на стрим; в WORM — только значимые решения.<BR/>Иначе поток событий ×5–10 и стоимость WORM/SIEM становятся неприемлемыми.</FONT>>, shape=note, fillcolor="#fef9c3", color="#ca8a04"];
}
